# Google OAuth（Google Cloud Console → API 和服務 → 憑證 → 建立 OAuth 用戶端 ID → 網頁應用程式）
# 已授權的重新導向 URI 需加上：
#   http://localhost:3000/api/auth/callback/google（本機開發）
#   https://你的網域/api/auth/callback/google（正式環境）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
# NEXTAUTH_SECRET 可用 `openssl rand -base64 32` 產生，或至 https://generate-secret.vercel.app/32 產生
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Supabase（Project Settings → API）
# 注意：SUPABASE_SERVICE_ROLE_KEY 只在伺服器端使用，切勿加上 NEXT_PUBLIC_ 前綴，也不要外流
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
